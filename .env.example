# ============================================================================
# 文明灵 (CivSim) - 环境变量配置
# ============================================================================

# ----------------------------------------------------------------------------
# DashScope API 配置 (阿里云百炼平台)
# 获取地址：https://dashscope.console.aliyun.com/
# ----------------------------------------------------------------------------

# API 密钥 (必填)
DASHSCOPE_API_KEY=sk-your-actual-api-key-here

# API 端点 (可选，默认：https://dashscope.aliyuncs.com/compatible-mode/v1)
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ----------------------------------------------------------------------------
# 模型配置 (可选，使用默认值)
# ----------------------------------------------------------------------------

# Qwen 系列模型
QWEN_PLUS_MODEL=qwen-plus
QWEN_MAX_MODEL=qwen-max

# DeepSeek 系列模型
# 注意：DashScope 的 DeepSeek 模型名称可能是 deepseek-v3 或 deepseek-chat
# 如果 deepseek-chat 不可用，尝试改为 deepseek-v3
DEEPSEEK_CHAT_MODEL=deepseek-chat
# DEEPSEEK_CHAT_MODEL=deepseek-v3
DEEPSEEK_REASONER_MODEL=deepseek-reasoner

# ----------------------------------------------------------------------------
# 使用说明：
# 1. 复制此文件为 .env
# 2. 填入你的 DASHSCOPE_API_KEY
# 3. 重启应用 (cargo tauri dev)
# ----------------------------------------------------------------------------
